              body:
                {}
              camera_link:
                {}
              imu_link:
                {}
              lidar_link:
                unilidar_lidar:
                  {}
              mag_link:
                {}
              wheel_fl_link:
                {}
              wheel_fr_link:
                {}
              wheel_rl_link:
                {}
              wheel_rr_link:
                {}
      Update Interval: 0
      Value: true
    - Alpha: 1
