<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="fusionlynx_materials" params="">

    <!-- =========================================================
         6061 铝合金：喷砂 + 阳极氧化哑光绿
         ========================================================= -->
    <material name="aluminum_anodized_matte_green">
      <color rgba="0.20 0.32 0.20 1.0"/>
    </material>

    <!-- =========================================================
         光泽黑
         比较深的纯黑，依靠 RViz 光照产生高光
         ========================================================= -->
    <material name="gloss_black">
      <color rgba="0.035 0.035 0.035 1.0"/>
    </material>

    <!-- =========================================================
         磨砂黑
         比光泽黑稍浅，视觉上更柔和
         ========================================================= -->
    <material name="matte_black">
      <color rgba="0.055 0.055 0.055 1.0"/>
    </material>

    <!-- =========================================================
         橡胶黑
         橡胶通常不是纯黑，而是略带灰的深黑
         ========================================================= -->
    <material name="rubber_black">
      <color rgba="0.12 0.12 0.115 1.0"/>
    </material>

    <!-- =========================================================
         普通黑色
         ========================================================= -->
    <material name="black">
      <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <!-- =========================================================
         深灰
         ========================================================= -->
    <material name="gray">
      <color rgba="0.45 0.45 0.45 1.0"/>
    </material>

    <!-- =========================================================
         浅灰
         ========================================================= -->
    <material name="light_gray">
      <color rgba="0.75 0.75 0.75 1.0"/>
    </material>

    <!-- =========================================================
         蓝色
         ========================================================= -->
    <material name="blue">
      <color rgba="0.15 0.25 0.75 1.0"/>
    </material>

  </xacro:macro>

</robot>