# ---------------------------------------------------------------------------
# FusionLynx ROS 2 workspace policy
# ---------------------------------------------------------------------------

# Colcon and ROS 2 generated state.
/.colcon/
/build/
/install/
/log/
**/log/
**/build/
**/install/

# Local IDE, code-index, agent, and editor state.
/.idea/
/.vscode/
**/.vscode/
**/.marscode/
/.codegraph/
/.codex/
/.agents/
/.claude/
/.literature_queue/
*.swp
*.swo

# Local research-paper extraction and temporary MinerU pipeline output.
/.mineru_output/

# Raw experiment artifacts. Keep manifests and small human-written metadata
# under version control; keep bags, clouds, maps, and databases outside Git.
/data/*
!/data/README.md
!/data/manifests/
!/data/manifests/**
*.bag
*.bag.active
*.db
*.db3
*.sqlite
*.sqlite3
*.mcap
*.pcd
*.ply
*.cam

# Generated TF graphs and temporary stress/debug files.
/frames_*.gv
/frames_*.pdf
/tmp/
tmp_*

# LaTeX and other generated paper build products.
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.out

# The current workspace has no Node package at these roots. Do not commit
# editor/tool-generated lock files here.
/package-lock.json
/src/package-lock.json

# Local agent state, review output, and configuration backups.
/.codebuddy/
/review_out/
/AGENTS.md.backup.*

# Thesis-document helpers kept local and intentionally excluded from Git.
/tools/insert_environment_table.py
/tools/polish_opening_report.py
