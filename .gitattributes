# Keep source and documentation diffs stable across Linux workstations.
* text=auto
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.rviz text eol=lf

# Binary assets are not line-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.stl binary
*.step binary
*.pcd binary
*.ply binary
*.bag binary
*.db binary
*.db3 binary
*.mcap binary
